{
  "name": "decorrelate",
  "version": "0.1.0",
  "description": "Measures whether your verifiers are actually independent. Three skeptics that share a model and a prompt are one check at 3x the price — this puts a number on it.",
  "keywords": ["agent", "verification", "correlation", "fleiss-kappa", "llm", "eval", "claude"],
  "license": "MIT",
  "author": "Erwin Lejeune",
  "repository": { "type": "git", "url": "git+https://github.com/Unchained-Labs/decorrelate.git" },
  "homepage": "https://unchained-labs.github.io/decorrelate/",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "decorrelate": "./dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": { "@types/node": "^22.7.4", "typescript": "^5.6.2", "vitest": "^2.1.2" },
  "packageManager": "pnpm@9.12.0"
}
